# ===== SmsForwarder Webhook 接收服务配置 =====
# 复制为 .env 后按需修改（.env 不要提交到 git）

# [必改] HMAC 加密密钥，与 SmsForwarder Webhook 通道里的「加密密钥」保持一致
SECRET=please-change-me-to-a-long-random-string

# [必改] 前端页面访问令牌，浏览器访问 URL 追加 ?token=xxx（或页面内填写）
PAGE_TOKEN=please-change-me-view-token

# 可选：webhook 额外鉴权密钥（SmsForwarder 端请求头加 X-Webhook-Key: 值）
# 与 SECRET 二选一即可；都不配置则任何请求都能写入（仅限本地调试！）
WEBHOOK_KEY=

# 服务端口（宿主机映射，见 docker-compose.yml 的 ${PORT:-8322}）
PORT=8322